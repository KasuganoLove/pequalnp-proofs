      have hk : w - n < j := by omega
      have he : n + (w - n) = w := by omega
      have hki := ih (w - n) hk (by omega) (by rwa [he])
      right
      apply (inCone_iff n C g j).mpr
      exact ⟨hj, w - n, hk, by rwa [he], hki⟩

