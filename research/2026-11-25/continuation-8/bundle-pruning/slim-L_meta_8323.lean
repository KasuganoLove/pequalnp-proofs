lemma fire_trace (n : ℕ) (C : Circuit) (hAO : IsAO2 n C) (x : Fin n → Bool) :
    ∀ w : ℕ, wv n C x w = true →
      (∃ u ∈ orIn n C w, x u = true) ∨
      ∃ j < C.gates.length, (gateAt C j).op = GateOp.and ∧
