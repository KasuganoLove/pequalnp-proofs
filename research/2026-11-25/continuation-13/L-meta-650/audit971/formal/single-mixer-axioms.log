  (shape :
    ∀ a ∈ PEqualNP.TopForm.tops G C, ∀ l ∈ PEqualNP.TopForm.side C a 0, ∀ r ∈ PEqualNP.TopForm.side C a 1, G.Adj l r)
  (trace :
    ∀ (u v : Fin n),
      s(u, v) ∈ PEqualNP.TopForm.Ustar G C →
        ∃ a ∈ PEqualNP.TopForm.tops G C,
          PEqualNP.EdgeOwnership.gateVal n C a (PEqualNP.EdgeOwnership.pairInput u v) = true) :
